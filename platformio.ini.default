; PlatformIO Project Configuration File
;
; ESP32-S3 N16 
;
;   pio run -t upload -t monitor
;
; https://docs.platformio.org/page/projectconf.html

[env:freenove_esp32_s3_wroom]
platform = espressif32 @ ^6.6.0
board = freenove_esp32_s3_wroom
framework = espidf
; The board manifest assumes 8 MB; this board actually has 16 MB.
board_upload.flash_size = 16MB
board_upload.maximum_size = 16777216
;board_build.partitions = partitions.csv

; Explicit port and upload speed

; ESP32 native port
;upload_port = /dev/ttyACM1
upload_speed = 115200
;monitor_port = /dev/ttyACM1
monitor_speed = 115200

; USB port

; CRITICAL: This prevents the CH343 from hanging the ESP32 in reset
; ONLY use when connected to USB port, NOT native port
;monitor_dtr = 1
;monitor_rts = 1

;monitor_filters = esp32_exception_decoder, direct
;monitor_filters = esp_idf_exception_decoder, direct

; Remove filters to see raw bootloader and crash logs
monitor_filters = direct

; ---------------------------------------------------------------------------
; Compile-time configuration
;
; Wi-Fi credentials and connection tuning are injected as preprocessor macros
; so nothing is hard-coded in the sources. Edit the two CHANGE_ME values below.
;
; To keep credentials out of version control instead, leave these commented and
; export them at build time:
;   export PLATFORMIO_BUILD_FLAGS='-D WIFI_SSID=\"my-ssid\" -D WIFI_PASSWORD=\"my-pass\"'
; ---------------------------------------------------------------------------
build_flags =
    ; Network to join. Quotes must be escaped so they survive to the compiler.
    -D WIFI_SSID=\"wifi SSID\"
    -D WIFI_PASSWORD=\"wifi password\"

    ; Name requested from the DHCP server.
    -D WIFI_HOSTNAME=\"retro-clock-radio\"

    ; Weakest acceptable AP security (wifi_auth_mode_t). Use WIFI_AUTH_OPEN for
    ; an unsecured network, WIFI_AUTH_WPA3_PSK to require WPA3.
    -D WIFI_AUTH_THRESHOLD=WIFI_AUTH_WPA2_PSK

    ; Association attempts before app_main() reboots the board; 0 = retry forever.
    -D WIFI_CONNECT_MAX_RETRY=0

    ; If no wifi connection is established after MAX_RETRY attempts, then either reboot (1) or skip (0)
    -D WIFI_CONNECT_RESTART_ON_FAIL=0    

    ; Per-attempt deadline for association + DHCP.
    -D WIFI_CONNECT_TIMEOUT_MS=15000

    ; Exponential backoff bounds between attempts.
    -D WIFI_CONNECT_BACKOFF_MIN_MS=1000
    -D WIFI_CONNECT_BACKOFF_MAX_MS=30000

    ; Silent pause at the top of app_main(), long enough to attach a serial
    ; monitor before the first log line. Set to 0 to boot straight through.
    -D BOOT_LOG_DELAY_MS=5000

    ; --- Real-time clock ---------------------------------------------------
    ; NTP server used to set the clock. This build has one server slot
    ; (CONFIG_LWIP_SNTP_MAX_SERVERS=1); pool.ntp.org rotates hosts on each
    ; DNS lookup, so one slot still spreads load and survives a dead host.
    -D NTP_SERVER=\"pool.ntp.org\"

    ; Local timezone as a POSIX TZ string, including DST rules. Examples:
    ;   UTC0
    ;   EST5EDT,M3.2.0,M11.1.0   (US/Canada Eastern)
    ;   CST6CDT,M3.2.0,M11.1.0   (US/Canada Central)
    ;   PST8PDT,M3.2.0,M11.1.0   (US/Canada Pacific)
    ;   CET-1CEST,M3.5.0,M10.5.0/3  (Central Europe)
    -D TIME_ZONE=\"EST5EDT,M3.2.0,M11.1.0\"

    ; How long app_main() waits for the first NTP response before carrying on.
    ; Not fatal: the client keeps retrying in the background.
    -D NTP_SYNC_TIMEOUT_MS=30000

    ; Interval between background re-syncs.
    -D NTP_SYNC_INTERVAL_MS=3600000

    ; --- Weather -----------------------------------------------------------
    ; OpenWeather One Call 3.0. That API needs its own "One Call by Call"
    ; subscription, which is free for the first 1000 calls a day; the polling
    ; interval and the cap below keep the firmware well inside that.
    ;
    ; The key is a secret, so it lives here rather than in the sources, and
    ; platformio.ini is not tracked by git. Omitting it fails the build.
    -D OWM_API_KEY=\"openweather api key\"

    ; Which forecast endpoint to call. data/2.5/forecast is reachable with an
    ; ordinary key: three-hourly, five days. data/3.0/onecall is hourly and
    ; richer but needs a separate "One Call by Call" subscription and returns
    ; 401 without one -- switching the path alone will not help.
    -D OWM_FORECAST_PATH=\"/data/2.5/forecast\"

    ; Where to forecast for, in decimal degrees. Strings rather than numbers:
    ; they are only ever pasted into a URL, and this sidesteps any argument
    ; about how a float is formatted.
    -D OWM_LATITUDE=\"xx.x\"
    -D OWM_LONGITUDE=\"yy.y\"

    ; standard (Kelvin), metric (Celsius) or imperial (Fahrenheit). The second
    ; macro is the same choice for the code, which cannot compare strings.
    -D OWM_UNITS=\"metric\"
    -D OWM_UNITS_ENUM=WX_UNITS_METRIC

    ; How often to fetch. Half-hourly is 48 calls a day; the forecast does not
    ; move faster than that, and an unchanged one costs no panel refresh.
    -D OWM_POLL_INTERVAL_S=1800

    ; The two brakes on the call budget. The daily cap is the obvious one; the
    ; minimum interval is the one that matters, because it is what stops a
    ; reboot loop making one call per boot.
    -D OWM_MAX_CALLS_PER_DAY=200
    -D OWM_MIN_CALL_INTERVAL_S=600

    ; Set to 1 to render from a canned response and make no network call at
    ; all. Costs 20 KB of flash for the payload, so leave it off in a real build.
    -D WEATHER_MOCK=0

    ; --- e-Paper display ---------------------------------------------------
    ; Waveshare 5.83" e-Paper (G), 648x480, black/white/yellow/red, 4-wire SPI.
    ; Defaults match Waveshare's own ESP32-S3 reference wiring; change them to
    ; match how the panel is actually cabled to the DevKitC header.
    -D EPD_PIN_SCLK=12
    -D EPD_PIN_MOSI=11
    -D EPD_PIN_CS=10
    -D EPD_PIN_DC=13
    -D EPD_PIN_RST=14
    -D EPD_PIN_BUSY=4

    ; Panel power control. This panel's pin-out is nine wires, not eight -- with
    ; PWR left floating the panel never powers up and reports nothing at all.
    ; Set to -1 only for an older 8-pin panel that has no PWR pin.
    -D EPD_PIN_PWR=5

    ; SPI host and clock. SPI2_HOST is the general-purpose host on the S3; the
    ; panel is rated to 20 MHz, but long ribbons are happier slower.
    -D EPD_SPI_HOST=SPI2_HOST
    -D EPD_SPI_SPEED_HZ=10000000

    ; Ceiling on a single BUSY wait. A full four-colour refresh takes ~25 s, so
    ; this is a wiring diagnostic rather than a deadline.
    -D EPD_BUSY_TIMEOUT_MS=60000

; Enable core debug output to see early boot logs
;    -D CORE_DEBUG_LEVEL=5

; Reset method for ESP32-S3 internal USB-Serial/JTAG
upload_flags =
    --before=default_reset
    --after=hard_reset
    --no-stub




